{
  "comments": {
    "lineComment": "#"
  },
  "wordPattern": "\\{[^}]*\\}?|\\w+",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.+:\\s*$",
    "decreaseIndentPattern": "^\\s*(else|else if)\\b"
  },
  "folding": {
    "offSide": true
  }
}
