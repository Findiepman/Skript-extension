        }
      },
      "contentName": "markup.inline.mc.dark-purple.skript",
      "patterns": [
        {
          "include": "#mc-inner"
        }
      ]
    },
    "mc-gold": {
      "begin": "(&6)",
      "end": "(?=&[0-9a-fA-FrR]|&#[0-9a-fA-F]{6}|<##?[0-9a-fA-F]{6}>|<(?:reset|r)>|\")|$",
      "beginCaptures": {
