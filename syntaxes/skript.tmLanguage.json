        }
      },
      "contentName": "markup.inline.mc.gray.skript",
      "patterns": [
        {
          "include": "#mc-inner"
        }
      ]
    },
    "mc-dark-gray": {
      "begin": "(&8)",
      "end": "(?=&[0-9a-fA-FrR]|&#[0-9a-fA-F]{6}|<##?[0-9a-fA-F]{6}>|<(?:reset|r)>|\")|$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.escape.minecraft.skript"
        }
      },
      "contentName": "markup.inline.mc.dark-gray.skript",
      "patterns": [
        {
          "include": "#mc-inner"
        }
      ]
    },
    "mc-blue": {
      "begin": "(&9)",
      "end": "(?=&[0-9a-fA-FrR]|&#[0-9a-fA-F]{6}|<##?[0-9a-fA-F]{6}>|<(?:reset|r)>|\")|$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.escape.minecraft.skript"
        }
      },
      "contentName": "markup.inline.mc.blue.skript",
      "patterns": [
        {
          "include": "#mc-inner"
        }
      ]
    },
    "mc-green": {
      "begin": "(&[aA])",
      "end": "(?=&[0-9a-fA-FrR]|&#[0-9a-fA-F]{6}|<##?[0-9a-fA-F]{6}>|<(?:reset|r)>|\")|$",
      "beginCaptures": {
        "1": {
