{
	"name": "claude-skript",
	"displayName": "PrimalMines Skript Tools",
	"description": "Skript syntax highlighting, snippets, and variable IntelliSense for PrimalMinesCore development",
	"version": "1.1.0",
	"publisher": "primalmines",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/primalmines/claude-skript-tools"
	},
	"engines": {
		"vscode": "^1.60.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:skript"
	],
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"contributes": {
		"languages": [
			{
				"id": "skript",
				"aliases": [
					"Skript",
					"skript"
				],
				"extensions": [
					".sk"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/skript.png",
					"dark": "./icons/skript.png"
				}
			}
		],
		"grammars": [
			{
				"language": "skript",
				"scopeName": "source.skript",
				"path": "./syntaxes/skript.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"[skript]": {
				"editor.acceptSuggestionOnEnter": "off",
				"editor.formatOnSave": true
			}
		}
	}
}
